# Flask 3.x uses FLASK_DEBUG, but STAJOS_ENV is used in app/__init__.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-in-production
# DATABASE_URL defaults to sqlite:///<BASE_DIR>/stajos_dev.db (absolute path) if not set
# Production örneği: DATABASE_URL=postgresql://user:pass@localhost/stajos
# Development için boş bırak (fallback BASE_DIR/stajos_dev.db kullanır, bkz config.py:22):
# sqlite:////absolute/path/stajos_dev.db veya boş bırak (fallback BASE_DIR/stajos_dev.db)
# Not: kurallar.md:38 gereği dev DB absolute path olmalı - config.py bunu BASE_DIR ile sağlar, burada relative kullanma
# DATABASE_URL=sqlite:///stajos_dev.db
